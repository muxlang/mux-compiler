import std.env
import std.net

func require_env(string key) returns string {
    auto result = env.get(key)
    if result.is_err() {
        assert(false, "failed to read environment variable: " + result.error().message())
        return ""
    }
    auto optional = result.value()
    if optional.is_none() {
        assert(false, "missing environment variable: " + key)
        return ""
    }
    return optional.value()
}

func main() returns void {
    auto base_url = require_env("MUX_TEST_HTTP_URL")
    print("Starting external http integration test")

    auto req = net.HttpRequest.new()
    req.method = "POST"
    req.url = base_url + "/mux?case=external"
    req.body = b"{\"message\":\"hello\",\"count\":2}"
    auto response_result = req.send()
    if response_result.is_err() {
        assert(false, "http request failed: " + response_result.error().message())
    } else {
        auto response = response_result.value()
        assert(response.status == 200, "unexpected status: " + response.status.to_string())
        auto body_result = response.read_bytes(16 * 1024 * 1024)
        if body_result.is_err() {
            assert(false, "failed to read body: " + body_result.error().message())
        }
    }

    auto invalid_req = net.HttpRequest.new()
    match invalid_req.send() {
        ok(_) { assert(false, "expected invalid request to fail") }
        err(e) { print("http invalid-request path validated: " + e.message()) }
    }

    print("external http integration test passed")

    return
}
