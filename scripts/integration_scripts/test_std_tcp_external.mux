import std.env
import std.net

func require_env(string key) returns string {
    auto result = env.get(key)
    if result.is_err() {
        assert(false, "failed to read environment variable: " + result.error().message())
        return ""
    }
    auto optional = result.value()
    if optional.is_none() {
        assert(false, "missing environment variable: " + key)
        return ""
    }
    return optional.value()
}

func main() returns void {
    auto addr = require_env("MUX_TEST_TCP_ADDR")
    const bytes payload = b"mux"
    const bytes expected = b"ACK:mux"
    print("Starting external tcp integration test")

    auto connect_result = net.TcpStream.connect(addr)
    if connect_result.is_err() {
        assert(false, "tcp connect failed: " + connect_result.error().message())
    } else {
        auto stream = connect_result.value()
        auto write_result = stream.write(payload)
        if write_result.is_err() {
            assert(false, "tcp write failed: " + write_result.error().message())
        } else {
            assert(write_result.value() == 3, "expected to write 3 bytes")
        }

        auto read_result = stream.read(16)
        if read_result.is_err() {
            assert(false, "tcp read failed: " + read_result.error().message())
        } else {
            auto response = read_result.value()
            assert(response.size() == expected.size(), "unexpected tcp response length")
            auto idx = 0
            while idx < expected.size() {
                assert(response[idx] == expected[idx], "unexpected tcp byte at index " + idx.to_string())
                idx = idx + 1
            }
            print("tcp ack received")
        }

        stream.close()
    }

    print("external tcp integration test passed")

    return
}
