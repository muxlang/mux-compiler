import std.dsa.collection.Collection

class BinaryTree<T is Comparable> is Collection<T> {
    int root
    int count
    list<T> values
    list<int> left_children
    list<int> right_children
    list<int> heights

    func len() returns int {
        return self.count
    }

    func normalize_root() returns void {
        if self.count == 0 || self.values.is_empty() {
            self.root = -1
        }
    
        return
    }

    func is_empty() returns bool {
        return self.count == 0
    }

    func clear() returns void {
        self.root = -1
        self.count = 0
        while !self.values.is_empty() {
            self.values.pop_back()
        }
        while !self.left_children.is_empty() {
            self.left_children.pop_back()
        }
        while !self.right_children.is_empty() {
            self.right_children.pop_back()
        }
        while !self.heights.is_empty() {
            self.heights.pop_back()
        }
    
        return
    }

    func to_list() returns list<T> {
        self.normalize_root()
        list<T> result = []
        list<int> stack = []
        auto current = self.root

        while current != -1 || !stack.is_empty() {
            while current != -1 {
                stack.push_back(current)
                current = self.left_children[current]
            }

            auto top_idx = stack.size() - 1
            auto node_idx = stack[top_idx]
            stack.pop_back()

            result.push_back(self.values[node_idx])
            current = self.right_children[node_idx]
        }

        return result
    }

    // Set semantics: duplicates are ignored.
    // If duplicate handling matters, check contains(value) before insert(value).
    func insert(T value) returns void {
        self.normalize_root()
        if self.root == -1 {
            self.root = self.create_node(value)
            self.count = 1
            return
        }

        if self.contains(value) {
            return
        }

        self.root = self.insert_node(self.root, value)
        self.count = self.count + 1
        return
    }

    func remove(T value) returns void {
        self.normalize_root()
        if self.root == -1 {
            return
        }

        if !self.contains(value) {
            return
        }
        self.root = self.remove_node(self.root, value)
        self.count = self.count - 1
        return
    }

    func contains(T value) returns bool {
        self.normalize_root()
        auto current = self.root

        while current != -1 {
            if value == self.values[current] {
                return true
            }

            if value < self.values[current] {
                current = self.left_children[current]
            } else {
                current = self.right_children[current]
            }
        }

        return false
    }

    func create_node(T value) returns int {
        auto idx = self.values.size()
        self.values.push_back(value)
        self.left_children.push_back(-1)
        self.right_children.push_back(-1)
        self.heights.push_back(1)
        return idx
    }

    func node_height(int index) returns int {
        if index == -1 {
            return 0
        }
        return self.heights[index]
    }

    func update_height(int index) returns void {
        if index == -1 {
            return
        }
        auto left_height = self.node_height(self.left_children[index])
        auto right_height = self.node_height(self.right_children[index])
        if left_height > right_height {
            self.heights[index] = left_height + 1
        } else {
            self.heights[index] = right_height + 1
        }
        return
    }

    func rotate_left(int index) returns int {
        auto pivot = self.right_children[index]
        auto middle = self.left_children[pivot]
        self.left_children[pivot] = index
        self.right_children[index] = middle
        self.update_height(index)
        self.update_height(pivot)
        return pivot
    }

    func rotate_right(int index) returns int {
        auto pivot = self.left_children[index]
        auto middle = self.right_children[pivot]
        self.right_children[pivot] = index
        self.left_children[index] = middle
        self.update_height(index)
        self.update_height(pivot)
        return pivot
    }

    func rebalance(int index) returns int {
        if index == -1 {
            return -1
        }
        self.update_height(index)
        auto balance = self.node_height(self.left_children[index]) - self.node_height(self.right_children[index])
        if balance > 1 {
            auto left = self.left_children[index]
            if self.node_height(self.right_children[left]) > self.node_height(self.left_children[left]) {
                self.left_children[index] = self.rotate_left(left)
            }
            return self.rotate_right(index)
        }
        if balance < -1 {
            auto right = self.right_children[index]
            if self.node_height(self.left_children[right]) > self.node_height(self.right_children[right]) {
                self.right_children[index] = self.rotate_right(right)
            }
            return self.rotate_left(index)
        }
        return index
    }

    func insert_node(int index, T value) returns int {
        if index == -1 {
            return self.create_node(value)
        }
        if value < self.values[index] {
            auto child = self.left_children[index]
            auto inserted = self.insert_node(child, value)
            self.left_children[index] = inserted
        } else {
            auto child = self.right_children[index]
            auto inserted = self.insert_node(child, value)
            self.right_children[index] = inserted
        }
        return self.rebalance(index)
    }

    func minimum_index(int index) returns int {
        auto current = index
        while self.left_children[current] != -1 {
            current = self.left_children[current]
        }
        return current
    }

    func remove_node(int index, T value) returns int {
        if index == -1 {
            return -1
        }
        if value < self.values[index] {
            self.left_children[index] = self.remove_node(self.left_children[index], value)
        } else if value > self.values[index] {
            self.right_children[index] = self.remove_node(self.right_children[index], value)
        } else {
            if self.left_children[index] == -1 {
                return self.right_children[index]
            }
            if self.right_children[index] == -1 {
                return self.left_children[index]
            }
            auto successor = self.minimum_index(self.right_children[index])
            self.values[index] = self.values[successor]
            self.right_children[index] = self.remove_node(self.right_children[index], self.values[successor])
        }
        return self.rebalance(index)
    }

    func min() returns optional<T> {
        self.normalize_root()
        if self.root == -1 {
            return none
        }

        auto current = self.root
        while self.left_children[current] != -1 {
            current = self.left_children[current]
        }

        return some(self.values[current])
    }

    func max() returns optional<T> {
        self.normalize_root()
        if self.root == -1 {
            return none
        }

        auto current = self.root
        while self.right_children[current] != -1 {
            current = self.right_children[current]
        }

        return some(self.values[current])
    }

    // -1 for an empty tree, 0 for a single node, matching the usual edge-count convention.
    func height() returns int {
        self.normalize_root()
        if self.root == -1 {
            return -1
        }

        list<int> node_stack = []
        list<int> depth_stack = []
        node_stack.push_back(self.root)
        depth_stack.push_back(0)

        int best = 0
        while !node_stack.is_empty() {
            auto top_idx = node_stack.size() - 1
            auto node = node_stack[top_idx]
            auto depth = depth_stack[top_idx]
            node_stack.pop_back()
            depth_stack.pop_back()

            if depth > best {
                best = depth
            }

            if self.left_children[node] != -1 {
                node_stack.push_back(self.left_children[node])
                depth_stack.push_back(depth + 1)
            }
            if self.right_children[node] != -1 {
                node_stack.push_back(self.right_children[node])
                depth_stack.push_back(depth + 1)
            }
        }

        return best
    }

    func preorder() returns list<T> {
        self.normalize_root()
        list<T> result = []
        list<int> stack = []
        if self.root != -1 {
            stack.push_back(self.root)
        }

        while !stack.is_empty() {
            auto top_idx = stack.size() - 1
            auto node = stack[top_idx]
            stack.pop_back()

            result.push_back(self.values[node])

            if self.right_children[node] != -1 {
                stack.push_back(self.right_children[node])
            }
            if self.left_children[node] != -1 {
                stack.push_back(self.left_children[node])
            }
        }

        return result
    }

    func postorder() returns list<T> {
        self.normalize_root()
        list<T> result = []
        list<int> stack = []
        if self.root != -1 {
            stack.push_back(self.root)
        }

        while !stack.is_empty() {
            auto top_idx = stack.size() - 1
            auto node = stack[top_idx]
            stack.pop_back()

            result.push_back(self.values[node])

            if self.left_children[node] != -1 {
                stack.push_back(self.left_children[node])
            }
            if self.right_children[node] != -1 {
                stack.push_back(self.right_children[node])
            }
        }

        int i = 0
        int j = result.size() - 1
        while i < j {
            auto tmp = result[i]
            result[i] = result[j]
            result[j] = tmp
            i = i + 1
            j = j - 1
        }

        return result
    }

    func level_order() returns list<T> {
        self.normalize_root()
        list<T> result = []
        if self.root == -1 {
            return result
        }

        list<int> queue = []
        queue.push_back(self.root)
        int head = 0

        while head < queue.size() {
            auto node = queue[head]
            head = head + 1
            result.push_back(self.values[node])

            if self.left_children[node] != -1 {
                queue.push_back(self.left_children[node])
            }
            if self.right_children[node] != -1 {
                queue.push_back(self.right_children[node])
            }
        }

        return result
    }
    }
