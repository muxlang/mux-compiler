import std.dsa.collection.Collection

class Graph<T is Hashable> is Collection<T> {
    map<T, set<T> > adjacency
    // Stores vertices in first-seen order for deterministic to_list output.
    list<T> vertices
    bool directed = true

    func len() returns int {
        return self.adjacency.size()
    }

    func is_empty() returns bool {
        return self.adjacency.is_empty()
    }

    func clear() returns void {
        auto keys = self.vertices
        int i = 0
        while i < keys.size() {
            auto key = keys[i]
            self.adjacency.remove(key)
            i = i + 1
        }

        while !self.vertices.is_empty() {
            self.vertices.pop_back()
        }
    
        return
    }

    func to_list() returns list<T> {
        // Deterministic contract: returns vertices in insertion order.
        return self.vertices
    }

    func add_vertex(T value) returns void {
        if !self.adjacency.contains(value) {
            set<T> empty = {}
            self.adjacency.put(value, empty)
            self.vertices.push_back(value)
        }
    
        return
    }

    func add_edge(T from, T to) returns void {
        self.add_vertex(from)
        self.add_vertex(to)
        set<T> neighbors = self.adjacency[from]
        neighbors.add(to)
        self.adjacency.put(from, neighbors)
        if !self.directed {
            set<T> reverse_neighbors = self.adjacency[to]
            reverse_neighbors.add(from)
            self.adjacency.put(to, reverse_neighbors)
        }
    
        return
    }

    func neighbors(T value) returns list<T> {
        if self.adjacency.contains(value) {
            return self.adjacency[value].to_list()
        }
        list<T> empty = []
        return empty
    }

    func bfs(T start) returns list<T> {
        list<T> order = []
        if !self.adjacency.contains(start) {
            return order
        }

        set<T> visited = {}
        list<T> queue = []
        int head = 0

        queue.push_back(start)
        visited.add(start)

        while head < queue.size() {
            auto current = queue[head]
            head = head + 1
            order.push_back(current)

            auto next_nodes = self.neighbors(current)
            int i = 0
            while i < next_nodes.size() {
                auto next = next_nodes[i]
                if !visited.contains(next) {
                    visited.add(next)
                    queue.push_back(next)
                }
                i = i + 1
            }
        }

        return order
    }

    func dfs(T start) returns list<T> {
        list<T> order = []
        if !self.adjacency.contains(start) {
            return order
        }

        set<T> visited = {}
        list<T> stack = []
        stack.push_back(start)

        while !stack.is_empty() {
            auto top_idx = stack.size() - 1
            auto current = stack[top_idx]
            stack.pop_back()

            if !visited.contains(current) {
                visited.add(current)
                order.push_back(current)

                auto next_nodes = self.neighbors(current)
                int i = next_nodes.size() - 1
                while i >= 0 {
                    stack.push_back(next_nodes[i])
                    i = i - 1
                }
            }
        }

        return order
    }

    func contains(T value) returns bool {
        return self.adjacency.contains(value)
    }

    func has_edge(T from, T to) returns bool {
        if !self.adjacency.contains(from) {
            return false
        }
        return self.adjacency[from].contains(to)
    }

    func degree(T value) returns int {
        return self.neighbors(value).size()
    }

    func remove_edge(T from, T to) returns void {
        if !self.adjacency.contains(from) {
            return
        }

        set<T> neighbors = self.adjacency[from]
        neighbors.remove(to)
        self.adjacency.put(from, neighbors)
        if !self.directed && self.adjacency.contains(to) {
            set<T> reverse_neighbors = self.adjacency[to]
            reverse_neighbors.remove(from)
            self.adjacency.put(to, reverse_neighbors)
        }

        return
    }

    common func new_directed() returns Graph<T> {
        auto out = Graph<T>.new()
        out.directed = true
        return out
    }

    common func new_undirected() returns Graph<T> {
        auto out = Graph<T>.new()
        out.directed = false
        return out
    }

    func remove_vertex(T value) returns void {
        if !self.adjacency.contains(value) {
            return
        }

        self.adjacency.remove(value)

        list<T> remaining_vertices = []
        int i = 0
        while i < self.vertices.size() {
            if self.vertices[i] != value {
                remaining_vertices.push_back(self.vertices[i])
            }
            i = i + 1
        }
        self.vertices = remaining_vertices

        int j = 0
        while j < self.vertices.size() {
            self.remove_edge(self.vertices[j], value)
            j = j + 1
        }

        return
    }

    // Kahn's algorithm. Returns none when the graph has a cycle, since no
    // valid linear ordering exists.
    func topological_sort() returns optional<list<T>> {
        map<T, int> in_degree = {:}
        int i = 0
        while i < self.vertices.size() {
            in_degree.put(self.vertices[i], 0)
            i = i + 1
        }

        i = 0
        while i < self.vertices.size() {
            auto next_nodes = self.adjacency[self.vertices[i]].to_list()
            int k = 0
            while k < next_nodes.size() {
                auto neighbor = next_nodes[k]
                in_degree.put(neighbor, in_degree[neighbor] + 1)
                k = k + 1
            }
            i = i + 1
        }

        list<T> queue = []
        int head = 0
        i = 0
        while i < self.vertices.size() {
            auto vertex = self.vertices[i]
            if in_degree[vertex] == 0 {
                queue.push_back(vertex)
            }
            i = i + 1
        }

        list<T> order = []
        while head < queue.size() {
            auto current = queue[head]
            head = head + 1
            order.push_back(current)

            auto next_nodes = self.neighbors(current)
            int k = 0
            while k < next_nodes.size() {
                auto neighbor = next_nodes[k]
                auto remaining = in_degree[neighbor] - 1
                in_degree.put(neighbor, remaining)
                if remaining == 0 {
                    queue.push_back(neighbor)
                }
                k = k + 1
            }
        }

        if order.size() != self.vertices.size() {
            return none
        }

        return some(order)
    }

    func has_cycle() returns bool {
        if !self.directed {
            return self.has_undirected_cycle()
        }
        auto order = self.topological_sort()
        if order.is_some() {
            return false
        }
        return true
    }

    // For an undirected graph, the reverse half of every edge is present, so
    // topological sorting would report every ordinary edge as a cycle. Track
    // each BFS node's parent instead and ignore that one reverse edge.
    func has_undirected_cycle() returns bool {
        set<T> visited = {}
        int root_index = 0
        while root_index < self.vertices.size() {
            auto root = self.vertices[root_index]
            if !visited.contains(root) {
                list<T> queue = []
                list<T> parents = []
                int head = 0
                queue.push_back(root)
                parents.push_back(root)
                visited.add(root)

                while head < queue.size() {
                    auto current = queue[head]
                    auto parent = parents[head]
                    head = head + 1
                    auto next_nodes = self.neighbors(current)
                    int i = 0
                    while i < next_nodes.size() {
                        auto next = next_nodes[i]
                        if next == current {
                            return true
                        }
                        if !visited.contains(next) {
                            visited.add(next)
                            queue.push_back(next)
                            parents.push_back(current)
                        } else if next != parent {
                            return true
                        }
                        i = i + 1
                    }
                }
            }
            root_index = root_index + 1
        }
        return false
    }

    // Directed connectivity follows outgoing edges from the first vertex.
    // For undirected graphs this is ordinary connectedness. Empty graphs are
    // connected by convention.
    func is_connected() returns bool {
        if self.vertices.is_empty() {
            return true
        }
        return self.bfs(self.vertices[0]).size() == self.vertices.size()
    }

    // Return one shortest unweighted path, if one exists. Neighbors are sets,
    // so the exact path is deterministic only up to the set's defined order.
    func shortest_path(T start, T target) returns optional<list<T>> {
        if !self.adjacency.contains(start) || !self.adjacency.contains(target) {
            return none
        }

        // Keep the BFS frontier and predecessor indices in parallel lists. It
        // avoids transient Optional/map values while still preserving generic
        // vertex values and deterministic reconstruction.
        list<T> discovered = []
        list<int> predecessors = []
        list<T> queue = []
        list<int> queue_indices = []
        int head = 0
        queue.push_back(start)
        discovered.push_back(start)
        predecessors.push_back(-1)
        queue_indices.push_back(0)
        int target_index = 0
        bool found_target = start == target

        while head < queue.size() {
            auto current = queue[head]
            int current_index = queue_indices[head]
            head = head + 1
            if current == target {
                target_index = current_index
                found_target = true
                break
            }
            auto next_nodes = self.neighbors(current)
            int i = 0
            while i < next_nodes.size() {
                auto next = next_nodes[i]
                bool seen = false
                int discovered_index = 0
                while discovered_index < discovered.size() {
                    if discovered[discovered_index] == next {
                        seen = true
                        break
                    }
                    discovered_index = discovered_index + 1
                }
                if !seen {
                    discovered.push_back(next)
                    predecessors.push_back(current_index)
                    queue.push_back(next)
                    queue_indices.push_back(discovered.size() - 1)
                }
                i = i + 1
            }
        }
        if !found_target {
            return none
        }

        list<T> reversed = []
        int step_index = target_index
        while step_index >= 0 {
            auto value = discovered[step_index]
            reversed.push_back(value)
            if value == start {
                break
            }
            step_index = predecessors[step_index]
        }

        list<T> path = []
        int i = reversed.size() - 1
        while i >= 0 {
            path.push_back(reversed[i])
            i = i - 1
        }
        return some(path)
    }
}
