// A match closes on any arm that cannot fail. A bare name binds the value and
// matches everything, so it needs no wildcard after it; and 'true'/'false'
// together cover a bool completely. Both were rejected as non-exhaustive.

func describe(int code) returns string {
    match code {
        200 { return "ok" }
        404 { return "missing" }
        other { return "code " + other.to_string() }
    }
}

func greet(string who) returns string {
    match who {
        "admin" { return "Hello, admin" }
        name { return "Hello, " + name }
    }
}

// A name that is already a constant is a TEST against it, not a binding, so it
// does not close the match. Treating it as one made every other value take
// that arm.
const int LIMIT = 10

func at_limit(int x) returns string {
    match x {
        LIMIT { return "at limit" }
        other { return "other: " + other.to_string() }
    }
}

func main() returns void {
    print(describe(200))
    print(describe(500))
    print(greet("admin"))
    print(greet("ana"))

    print(at_limit(10))
    print(at_limit(3))

    auto flag = true
    match flag {
        true { print("enabled") }
        false { print("disabled") }
    }
    return
}
