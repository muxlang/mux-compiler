// if used as an expression: single-line, else-if chains, and multi-line
// branches whose value spans lines. Each branch is a single value expression;
// an else-if chain is parsed as a nested if-expression in the else branch.

func grade(int score) returns string {
    return if score >= 90 {
        "A"
    } else if score >= 80 {
        "B"
    } else if score >= 70 {
        "C"
    } else {
        "F"
    }
}

// Newlines are allowed around `else` (`}` then `else` on the next line, and
// `else` then `if` on the next line), matching the statement-form if.
func tier(int n) returns string {
    return if n >= 100 { "high" }
    else if n >= 10 { "mid" }
    else { "low" }
}

func main() returns void {
    // single-line form
    auto x = 5
    auto sign = if x > 0 { "positive" } else { "non-positive" }
    print(sign)

    // multi-line else-if chain via a function
    print(grade(95))
    print(grade(85))
    print(grade(72))
    print(grade(40))

    // multi-line branches inline
    auto label = if x >= 10 {
        "big"
    } else {
        "small"
    }
    print(label)

    print(tier(500))
    print(tier(50))
    print(tier(5))
    return
}
