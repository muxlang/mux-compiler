// UDP-focused net smoke test that prints every successful step.
import std.net

func run_udp() returns result<int, NetError> {
    auto sock = use net.UdpSocket.bind("127.0.0.1:0")
    auto local_addr = use sock.local_addr()
    print("Bound udp socket on " + local_addr)
    use sock.set_nonblocking(false)
    print("Confirmed blocking mode")
    use sock.set_recv_buffer_size(4096)
    print("Configured receive buffer")
    use sock.set_send_buffer_size(4096)
    print("Configured send buffer")

    const bytes payload = b"test"
    auto bytes_written = use sock.send_to(payload, local_addr)
    print("Sent " + bytes_written.to_string() + " bytes to " + local_addr)

    auto response = use sock.recv_from(32)
    auto sender = use response.address()
    assert(sender == local_addr, "sender mismatch")
    print("Received datagram from " + sender)
    auto received = use response.bytes()
    assert(received[0] == payload[0], "payload mismatch")
    print("Received " + received.to_string())
    auto was_truncated = use response.truncated()
    assert(!was_truncated, "datagram unexpectedly truncated")
    print("udp success")

    sock.close()
    return ok(1)
}

func main() returns void {
    print("Starting udp loopback test")
    auto result = run_udp()
    if result.is_err() {
        assert(false, result.error().message())
    }
    return
}
