// Should fail: a class cannot key a map even when it declares Hashable. Map
// keys are hashed and compared inside the runtime, which knows nothing about a
// user 'hash' method, so two structurally equal keys would become two entries.
// Rejecting is the honest answer until the runtime can call back into the type.
class K is Hashable {
    int n

    func hash() returns int {
        return self.n
    }
}

func main() returns void {
    auto m = {K.new(): 1}
    print(m.size().to_string())
    return
}
