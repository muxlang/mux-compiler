// Importing a type does not import the interfaces it implements.
//
// `Graph` declares `is Collection`, and `Collection` lives in a sibling module.
// Without it in scope, codegen used to fail building the interface's type and
// report an internal compiler error - telling the user to file a compiler bug
// about their own program. Per issue #360 that rejection belongs in semantics,
// where the import statement gives a span and the message can name the fix.
//
// The check is deliberately deferred until every import has been resolved, so
// it does not depend on the order the imports are written: importing `Graph`
// on one line and `Collection` on the next is accepted.

import std.dsa.graph.Graph

func main() returns void {
    auto g = Graph<string>.new()
    g.add_vertex("a")
    print(g.len().to_string())
    return
}
