// A nested enum that shares a payload position with a differently-typed payload
// (here Inner vs int) cannot use the inline single-type union slot, so it is
// rejected with a clear error rather than corrupting memory (issue #306). A
// max-size union layout for heterogeneous positions is a separate, future
// feature.

enum Inner { W(string), Z(int) }
enum Mix { A(Inner), B(int) }

func main() returns void {
    auto m = Mix.A(Inner.W("hi"))
    match m {
        A(i) { print("a") }
        B(n) { print("b") }
    }
    return
}
