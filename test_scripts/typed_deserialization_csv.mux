// CSV rows read into a declared type.
//
// The difference from JSON is that a CSV cell is always TEXT: `3` in a file is
// the string "3", so an `int` column is parsed rather than type-checked. That is
// also why the supported column types stop at the primitives - a nested class
// cannot come out of a single cell.
//
// There is deliberately no singular `from_csv`. A CSV document is a table, so a
// singular form would only work for a file with exactly one row.

class Row {
    string sku
    int qty
    float price
    bool active
    optional<string> note
}

func show(string label, string text) returns void {
    match Row.list_from_csv(text) {
        ok(rows) {
            print(label + ": " + rows.len().to_string() + " row(s)")
            for Row r in rows {
                match r.note {
                    some(n) { print("  " + r.sku + " note=" + n) }
                    none {
                        print("  " + r.sku + " x" + r.qty.to_string()
                            + " @" + r.price.to_string() + " active=" + r.active.to_string())
                    }
                }
            }
        }
        err(e) { print(label + ": " + e) }
    }
    return
}

func main() returns void {
    show("typed", "sku,qty,price,active,note\nwidget,3,1.5,true,first\ngadget,7,2.25,false,second\n")

    // `optional` means the COLUMN may be missing from the header. Within a row
    // that has the column, an empty cell is an empty string - CSV cannot tell
    // "empty" from "absent" once the column exists.
    show("no note column", "sku,qty,price,active\nwidget,3,1.5,true\n")

    // A cell that does not parse names the column, not the row.
    show("bad number", "sku,qty,price,active,note\nwidget,many,1.5,true,n\n")

    // Only `true` and `false` are booleans. `1` is a number in some files and a
    // flag in others, so it is not guessed.
    show("bad bool", "sku,qty,price,active,note\nwidget,1,1.5,1,n\n")

    // A header the class does not declare is ignored, like an extra JSON field.
    show("extra column", "sku,qty,price,active,note,added\nwidget,3,1.5,true,n,9\n")

    return
}
