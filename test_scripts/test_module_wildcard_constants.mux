// Constants imported directly into scope resolve by their bare name, including
// names that start with a builtin-function prefix.
import modglobal_c.*

func main() returns void {
    print("err_threshold: " + err_threshold.to_string())
    print("print_width:   " + print_width.to_string())
    print("some_label:    " + some_label)
    return
}
